# Ashmora CityMind AI Environment Variables
PROJECT_NAME="Ashmora CityMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="ashmora-citymind-ai-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL with SQLite async fallback for local dev)
DATABASE_URL="sqlite+aiosqlite:///./citymind.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://citymind_user:citymind_password@localhost:5432/citymind_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Gemini AI API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"

# SMTP Configuration (required to actually send OTP emails).
# If not set, the OTP is printed/logged on the backend console instead.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="your-app-password"
# FROM_EMAIL="noreply@ashmora.gov"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
