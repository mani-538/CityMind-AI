# ============================================================
# Ashmora CityMind AI — Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ---------------------------
# App
# ---------------------------
PROJECT_NAME="Ashmora CityMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------
# Database
# ---------------------------
# SQLite (local dev)
DATABASE_URL="sqlite+aiosqlite:///./citymind.db"

# PostgreSQL (production - Render / Supabase / Neon)
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/citymind_db"

# ---------------------------
# Redis (optional, for rate limiting)
# ---------------------------
REDIS_URL="redis://localhost:6379/0"

# ---------------------------
# AI — Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# ---------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ---------------------------
# SMTP — Email / OTP Configuration
# ---------------------------
# Set EMAILS_ENABLED=true to dispatch real OTP emails
EMAILS_ENABLED=false

# Gmail SMTP (recommended for quick setup)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER="your-gmail@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Sender identity (shown in From: field)
EMAILS_FROM_EMAIL="noreply@ashmora.gov"
EMAILS_FROM_NAME="Ashmora CityMind Security"

# Alternative SMTP providers:
# SendGrid: smtp.sendgrid.net  port 587
# Mailgun:  smtp.mailgun.org   port 587
# Resend:   smtp.resend.com    port 465

# ---------------------------
# CORS
# ---------------------------
# Allow all origins (dev / public demo)
CORS_ORIGINS=["*"]

# Restrict to specific frontend URLs (production)
# CORS_ORIGINS=["https://city-mind-ai-three.vercel.app","https://ashmora.gov"]
