# ============================================================
# Ashmora CityMind AI — Backend Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ---------------------------
# App
# ---------------------------
PROJECT_NAME="Ashmora CityMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------
# Database
# ---------------------------
# SQLite (local dev)
DATABASE_URL="sqlite+aiosqlite:///./citymind.db"
# PostgreSQL (production — Render/Supabase/Neon)
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/citymind_db"

# ---------------------------
# Redis (optional)
# ---------------------------
REDIS_URL="redis://localhost:6379/0"

# ---------------------------
# AI — Gemini API Key
# https://aistudio.google.com/app/apikey
# ---------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ---------------------------
# Email OTP — Resend.com
# 1. Sign up free at https://resend.com
# 2. API Keys → Create API Key → paste below
# 3. Set EMAILS_ENABLED=true
# Free tier: 3,000 emails/month, no credit card
# ---------------------------
EMAILS_ENABLED=false
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAILS_FROM_EMAIL="noreply@ashmora.gov"
EMAILS_FROM_NAME="Ashmora CityMind Security"

# NOTE: On Resend free tier (without domain), emails
# can only be sent to your own verified email address.
# To send to all users → verify your domain at resend.com/domains

# ---------------------------
# CORS
# ---------------------------
CORS_ORIGINS=["*"]
# Production: CORS_ORIGINS=["https://city-mind-ai-three.vercel.app"]
